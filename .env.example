# Aban Environment Variables Template
# Copy this file to '.env' and fill in the values below.
# DO NOT commit the actual '.env' file to Git/GitHub.

# Google AI Studio (Gemini) API Key for advanced features (optional)
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face FastAPI translation backend base URL
ABAN_AI_BACKEND_URL=https://norahmt-aban-ai-backend.hf.space

# Google Cloud Platform Text-to-Speech API Key
# If left blank, the app will automatically fall back to the native offline TTS engine.
ABAN_GCP_TTS_API_KEY=
